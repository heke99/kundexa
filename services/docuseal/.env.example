# Keep the filled .env private on the future server. Use generated hex values.
# External Postgres mode only (base compose.yaml requires it during interpolation).
DOCUSEAL_DATABASE_URL=postgresql://docuseal:REPLACE_WITH_HEX_PASSWORD@postgres:5432/docuseal
# Required only with compose.with-postgres.yaml; use the same password as the URL.
DOCUSEAL_DB_PASSWORD=REPLACE_WITH_HEX_PASSWORD
DOCUSEAL_SECRET_KEY_BASE=REPLACE_WITH_GENERATED_RAILS_SECRET
DOCUSEAL_ENCRYPTION_SECRET=REPLACE_WITH_PERSISTENT_ENCRYPTION_SECRET
